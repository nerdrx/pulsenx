<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Typography ===== -->

    <!-- Base of the dot-notation text family; everything below inherits it implicitly. -->
    <style name="NxText">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="NxText.LargeTitle">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/nx_text_strong</item>
    </style>

    <style name="NxText.HeaderSubtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/nx_muted</item>
    </style>

    <!-- Small all-caps label above a card's content. -->
    <style name="NxText.Eyebrow">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/nx_muted</item>
    </style>

    <style name="NxText.CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/nx_text_strong</item>
    </style>

    <style name="NxText.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/nx_dim</item>
    </style>

    <style name="NxText.RowLabel">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/nx_text</item>
    </style>

    <style name="NxText.RowDesc">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/nx_dim</item>
    </style>

    <!-- Status values are tinted from Kotlin (ok / warn / bad) - no colour here. -->
    <style name="NxText.StatusValue">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="NxText.TileValue">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/nx_text_strong</item>
    </style>

    <style name="NxText.TileCaption">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/nx_dim</item>
    </style>

    <style name="NxText.Footer">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/nx_dim</item>
    </style>

    <!-- ===== Controls ===== -->

    <style name="NxPill">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="NxPill.Primary">
        <item name="android:background">@drawable/pill_primary</item>
        <item name="android:textColor">@color/nx_text_strong</item>
    </style>

    <style name="NxPill.Secondary">
        <item name="android:background">@drawable/pill_secondary</item>
        <item name="android:textColor">@color/nx_text</item>
    </style>

    <style name="NxSegment">
        <item name="android:background">@drawable/segment_item</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="NxSwitch">
        <item name="android:track">@drawable/switch_track_glass</item>
        <item name="android:thumb">@drawable/switch_thumb_glass</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:showText">false</item>
        <item name="android:switchMinWidth">48dp</item>
        <item name="android:thumbTextPadding">0dp</item>
        <!-- Custom thumb drops the platform ripple; put a borderless one back, and
             keep the touch target at the 48dp accessibility minimum. -->
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Glass surfaces -->
    <style name="NxCard">
        <item name="android:background">@drawable/glass_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="NxTile">
        <item name="android:background">@drawable/glass_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
</resources>
