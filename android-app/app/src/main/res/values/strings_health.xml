    <string name="health_src_missing">Health Connect not installed</string>
    <string name="health_src_update">Health Connect needs an update</string>
    <string name="health_src_permission">Health Connect access not granted</string>
    <string name="health_src_error">Health Connect read failed</string>

    <!-- Health card status line -->
    <string name="health_status_missing">Health Connect is not installed — tap to get it</string>
