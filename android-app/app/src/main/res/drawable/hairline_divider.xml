<?xml version="1.0" encoding="utf-8"?>
<!-- Divider that fades out at both ends, so it never collides with the card hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="@color/glass_hairline_soft"
        android:endColor="@color/glass_specular_none"
        android:startColor="@color/glass_specular_none"
        android:type="linear" />
</shape>
