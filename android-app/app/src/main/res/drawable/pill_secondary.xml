<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action (NX §5): glass-chip fill with a lit edge, no violet.
     Same 5dp chamfer as the primary. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="5dp" />
                    <gradient
                        android:angle="315"
                        android:endColor="@color/glass_chip_deep"
                        android:startColor="@color/glass_chip_lit"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_hairline_soft" />
                </shape>
            </item>

            <item
                android:gravity="top|fill_horizontal"
                android:height="1dp"
                android:left="5dp"
                android:right="5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/glass_hairline_fade"
                        android:startColor="@color/glass_hairline_bright"
                        android:type="linear" />
                </shape>
            </item>

            <item
                android:gravity="bottom|fill_horizontal"
                android:height="1dp"
                android:left="5dp"
                android:right="5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/glass_edge_shadow"
                        android:startColor="@color/glass_specular_none"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
