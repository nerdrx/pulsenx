<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action pill: violet gradient, glossy top edge, ripple clipped to the pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="315"
                        android:endColor="@color/nx_accent_grad_b"
                        android:startColor="@color/nx_accent_grad_a"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_hairline_soft" />
                </shape>
            </item>

            <item
                android:gravity="top|fill_horizontal"
                android:height="20dp"
                android:left="2dp"
                android:right="2dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/glass_specular_none"
                        android:startColor="@color/glass_specular_top"
                        android:type="linear" />
                </shape>
            </item>

            <item
                android:gravity="top|fill_horizontal"
                android:height="1dp"
                android:left="28dp"
                android:right="28dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/glass_hairline_fade"
                        android:startColor="@color/glass_hairline_bright"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#ffffffff" />
        </shape>
    </item>
</ripple>
