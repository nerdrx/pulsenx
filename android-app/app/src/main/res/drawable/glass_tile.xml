<?xml version="1.0" encoding="utf-8"?>
<!-- Small glass tile (mini stats). Same language as glass_card, tighter radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>

    <item
        android:gravity="top|fill_horizontal"
        android:height="30dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="17dp"
                android:topRightRadius="17dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_specular_none"
                android:startColor="@color/glass_specular_top"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/glass_hairline_fade"
                android:startColor="@color/glass_hairline_bright"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
