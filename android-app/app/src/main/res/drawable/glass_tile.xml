<?xml version="1.0" encoding="utf-8"?>
<!-- Small tier-1 tile (mini stats). Same language as glass_card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:centerColor="@color/glass_fill_mid"
                android:endColor="@color/glass_fill_deep"
                android:startColor="@color/glass_fill_lit"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>


    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/glass_hairline_fade"
                android:startColor="@color/glass_hairline_bright"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:gravity="bottom|fill_horizontal"
        android:height="1dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/glass_edge_shadow"
                android:startColor="@color/glass_specular_none"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
