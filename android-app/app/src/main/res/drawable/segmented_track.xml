<?xml version="1.0" encoding="utf-8"?>
<!-- Container for the pill segmented control: a recessed glass trough. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_fill_inset" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>
</layer-list>
