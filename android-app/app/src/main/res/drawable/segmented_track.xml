<?xml version="1.0" encoding="utf-8"?>
<!-- Container for the segmented control: a well trough, lit from upper-left,
     cut to the same 5dp as the segments it holds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="5dp" />
    <gradient
        android:angle="315"
        android:endColor="@color/glass_well_bottom"
        android:startColor="@color/glass_well_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/nx_line" />
</shape>
