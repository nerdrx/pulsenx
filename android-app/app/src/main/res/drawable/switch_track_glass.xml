<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: a well trough off, a lit violet block on - 5dp chamfer, no pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size
                android:width="48dp"
                android:height="30dp" />
            <corners android:radius="5dp" />
            <gradient
                android:angle="315"
                android:centerColor="@color/nx_accent_grad_body"
                android:endColor="@color/nx_accent_grad_deep"
                android:startColor="@color/nx_accent_grad_lit"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline_soft" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <size
                android:width="48dp"
                android:height="30dp" />
            <corners android:radius="5dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/glass_well_bottom"
                android:startColor="@color/glass_well_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/nx_line" />
        </shape>
    </item>
</selector>
