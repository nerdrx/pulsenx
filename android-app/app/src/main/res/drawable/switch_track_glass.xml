<?xml version="1.0" encoding="utf-8"?>
<!-- Glass switch track; violet gradient once checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size
                android:width="48dp"
                android:height="30dp" />
            <corners android:radius="100dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/nx_accent_grad_b"
                android:startColor="@color/nx_accent_grad_a"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline_soft" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <size
                android:width="48dp"
                android:height="30dp" />
            <corners android:radius="100dp" />
            <solid android:color="@color/nx_track_off" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>
</selector>
