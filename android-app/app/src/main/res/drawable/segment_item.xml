<?xml version="1.0" encoding="utf-8"?>
<!--
  One segment of the source selector. Logic only flips isSelected;
  android:state_selected drives the violet pill highlight, lit from the upper-left
  exactly like pill_primary.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">

    <item>
        <selector>
            <item android:state_selected="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="100dp" />
                            <gradient
                                android:angle="315"
                                android:centerColor="@color/nx_accent_grad_body"
                                android:endColor="@color/nx_accent_grad_deep"
                                android:startColor="@color/nx_accent_grad_lit"
                                android:type="linear" />
                            <stroke
                                android:width="1dp"
                                android:color="@color/glass_hairline_soft" />
                        </shape>
                    </item>
                    <item
                        android:gravity="top|fill_horizontal"
                        android:height="1dp"
                        android:left="22dp"
                        android:right="22dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="0"
                                android:endColor="@color/glass_hairline_fade"
                                android:startColor="@color/glass_hairline_bright"
                                android:type="linear" />
                        </shape>
                    </item>
                    <item
                        android:gravity="bottom|fill_horizontal"
                        android:height="1dp"
                        android:left="22dp"
                        android:right="22dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="0"
                                android:endColor="@color/glass_edge_shadow"
                                android:startColor="@color/glass_specular_none"
                                android:type="linear" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
