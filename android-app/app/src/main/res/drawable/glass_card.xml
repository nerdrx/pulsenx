<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid-glass card: translucent white body over the aurora, a 1dp hairline,
  a specular wash in the top third and a bright top edge that fades left→right
  (the "light source is up and to the left" cue).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Body + uniform hairline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>

    <!-- Specular sheen: white 10% → 0 down the top third -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="88dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_specular_none"
                android:startColor="@color/glass_specular_top"
                android:type="linear" />
        </shape>
    </item>

    <!-- Bright top edge, 40% → 5% across the flat span between the corner arcs -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/glass_hairline_fade"
                android:startColor="@color/glass_hairline_bright"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
