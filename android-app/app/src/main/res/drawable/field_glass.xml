<?xml version="1.0" encoding="utf-8"?>
<!-- Inset glass field: reads as a well pressed into the card, violet rim on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_fill_inset" />
            <stroke
                android:width="1dp"
                android:color="@color/nx_accent_soft" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_fill_inset" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>
</selector>
